---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  slides: ImageMetadata[];
  visibleSeconds?: number;
  fadeSeconds?: number;
}

const { slides, visibleSeconds = 5, fadeSeconds = 1 } = Astro.props;

const step = visibleSeconds + fadeSeconds;
const total = step * slides.length;
const pct = (s: number) => ((s / total) * 100).toFixed(3);

const keyframes = `
@keyframes hero-fade {
  0%   { opacity: 0; }
  ${pct(fadeSeconds)}% { opacity: 1; }
  ${pct(step)}% { opacity: 1; }
  ${pct(step + fadeSeconds)}% { opacity: 0; }
  100% { opacity: 0; }
}`;
---

<style is:inline set:html={keyframes}></style>

<div class="absolute inset-0" aria-hidden="true">
  {
    slides.map((src, i) => (
      <Image
        src={src}
        alt=""
        class="hero-slide"
        loading={i === 0 ? "eager" : "lazy"}
        fetchpriority={i === 0 ? "high" : undefined}
        widths={[800, 1280, 1920]}
        sizes="100vw"
        style={`animation: hero-fade ${total}s linear infinite; animation-delay: ${i * step - fadeSeconds}s;`}
      />
    ))
  }
</div>

<div class="absolute inset-0 bg-[#071e3d]/50"></div>

<style>
  .hero-slide {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
  }
  .hero-slide:first-child {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-slide {
      animation: none !important;
    }
    .hero-slide:not(:first-child) {
      opacity: 0;
    }
  }
</style>
