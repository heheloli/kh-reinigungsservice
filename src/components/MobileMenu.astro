<script>
  const DURATION = 300; // keep in sync with duration-300 on the panel
  const LABELS = { open: "Menü öffnen", close: "Menü schließen" };

  function initMobileMenu(
    menu: HTMLElement,
    panel: HTMLElement,
    button: HTMLElement,
  ) {
    const header = document.getElementById("header");
    const desktop = window.matchMedia("(min-width: 768px)"); // Tailwind md
    let isOpen = false;
    let hideTimer: number | undefined;

    function setButtonState(open: boolean) {
      button.setAttribute("aria-expanded", String(open));
      button.setAttribute("aria-label", open ? LABELS.close : LABELS.open);
    }

    function positionBelowHeader() {
      if (header) {
        menu.style.top = `${header.getBoundingClientRect().height}px`;
      }
    }

    function openMenu() {
      if (isOpen) return;
      isOpen = true;
      clearTimeout(hideTimer); // cancel a pending "hide" from a quick close

      positionBelowHeader();
      menu.classList.remove("hidden", "pointer-events-none");
      void panel.offsetHeight; // force reflow so the slide-down transition runs
      panel.classList.remove("-translate-y-full");

      document.body.classList.add("menu-open");
      setButtonState(true);
      document.addEventListener("keydown", onKeydown);

      panel
        .querySelector<HTMLElement>("a[href]")
        ?.focus({ preventScroll: true });
    }

    function closeMenu(restoreFocus = true) {
      if (!isOpen) return;
      isOpen = false;

      panel.classList.add("-translate-y-full");
      menu.classList.add("pointer-events-none"); // page is clickable right away

      document.body.classList.remove("menu-open");
      setButtonState(false);
      document.removeEventListener("keydown", onKeydown);

      if (restoreFocus) button.focus();

      hideTimer = window.setTimeout(
        () => menu.classList.add("hidden"),
        DURATION,
      );
    }

    function onKeydown(e: KeyboardEvent) {
      if (e.key === "Escape") closeMenu();
    }

    // The button now toggles instead of only opening
    button.setAttribute("aria-controls", panel.id);
    setButtonState(false);
    button.addEventListener("click", () => (isOpen ? closeMenu() : openMenu()));

    // Tap on the empty area below the panel closes the menu
    menu.addEventListener("click", (e) => {
      if (e.target === menu) closeMenu();
    });

    // Links close the menu
    menu.querySelectorAll<HTMLElement>("[data-close-menu]").forEach((link) => {
      link.addEventListener("click", () => closeMenu());
    });

    // Don't leave the menu (and the scroll lock) open when resizing/rotating to desktop
    desktop.addEventListener("change", (e) => {
      if (e.matches) closeMenu(false);
    });

    if (header && "ResizeObserver" in window) {
      new ResizeObserver(positionBelowHeader).observe(header);
    }
  }

  const menu = document.getElementById("mobile-menu");
  const panel = document.getElementById("mobile-menu-panel");
  const button = document.getElementById("mobile-menu-button");

  if (menu && panel && button) initMobileMenu(menu, panel, button);
</script>
