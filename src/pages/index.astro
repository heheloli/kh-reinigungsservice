---
import Layout from "../layouts/Layout.astro";
import HeroSlideshow from "../components/HeroSlideshow.astro";
import SlideBtn from "../components/SlideBtn.astro";
import SlideLink from "../components/SlideLink.astro";
import ServicesCarousel from "../components/ServicesCarousel.astro";
import TrustCard from "../components/TrustCard.astro";

import Slide1 from "../assets/slideshow/slide1.png";
import Slide2 from "../assets/slideshow/slide2.png";
import Slide3 from "../assets/slideshow/slide3.png";

import Icon1 from "../assets/Icon1.webp";
import Icon2 from "../assets/Icon2.webp";
import Icon3 from "../assets/Icon3.webp";
import Icon4 from "../assets/Icon4.webp";

const pageTitle = "K&H Gebäudereinigung";

const slides = [Slide1, Slide2, Slide3];

const trustItems = [
  {
    title: "Vertrauen",
    description: "Transparenter Umgang mit unseren Kunden",
    image: Icon1,
  },
  {
    title: "Qualität",
    description: "Gründliche und sorgfältige Reinigung",
    image: Icon2,
  },
  {
    title: "Zuverlässigkeit",
    description: "Pünktliche und planbare Reinigungstermine",
    image: Icon3,
  },
  {
    title: "Kundennähe",
    description: "Persönliche Betreuung und Kommunikation",
    image: Icon4,
  },
];
---

<Layout pageTitle={pageTitle}>
  <!-- Hero -->
  <section class="bg-[#071e3d] py-24 px-4 border-b border-gray-200 relative h-[calc(100svh-120px)] overflow-hidden">
    <HeroSlideshow slides={slides} visibleSeconds={7} fadeSeconds={1} />
    <div class="max-w-6xl mx-auto flex items-center h-full relative z-10">
      <div>
        <h1 class="text-5xl font-bold mb-6 text-white">
          Wir bringen Glanz in Ihre Räume
        </h1>
        <p class="text-lg text-white mb-8">
          Reinigungsservice für Privat- und Gewerbekunden in Worms und Umgebung
        </p>
        :
        <div class="flex justify-center">
          <SlideBtn
            href="/kontakt"
            text="Jetzt anfragen"
            width="w-100"
            height="h-19"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- About -->
  <section class="py-24 px-4 border-b border-gray-200">
    <div class="max-w-5xl mx-auto text-center">
      <h2 class="text-3xl font-bold mb-6">Über uns</h2>

      <p class="text-lg text-gray-600 max-w-xl mx-auto mb-10 leading-relaxed">
        Sauberkeit ist unsere Leidenschaft. Mit maßgeschneiderten
        Reinigungslösungen für Büros, Treppenhäuser, Praxen, Gewerbeobjekte
        sowie Privathaushalte garantieren wir höchste Qualität und Sorgfalt. Ob
        Unternehmen oder Privatkunde - wir arbeiten gründlich und zuverlässig.
      </p>

      <SlideLink text="Weitere Informationen" href="/ueber-uns" />
    </div>
  </section>

  <!-- Services -->
  <section class="py-24 px-4 bg-white border-b border-gray-200">
    <div class="max-w-6xl mx-auto">
      <div class="mb-16 max-w-2xl">
        <h2 class="text-3xl font-bold mb-4">Unsere Leistungen</h2>
        <p class="text-gray-600">
          Wir bieten ein breites Spektrum an Reinigungsdienstleistungen für
          unterschiedliche Anforderungen.
        </p>
      </div>

      <ServicesCarousel />

      <div class="text-center mt-12">
        <SlideLink text="Weitere Informationen" href="/leistungen" />
      </div>
    </div>
  </section>

  <!-- Trust -->
  <section class="py-24 px-4 bg-white">
    <div class="max-w-6xl mx-auto grid md:grid-cols-2">
      <div class="px-6">
        <h2 class="text-3xl font-bold mb-8">
          Was uns als Reinigungsunternehmen auszeichnet
        </h2>
        <p class="text-gray-600 text-lg mb-8">
          Im Mittelpunkt unserer Arbeit stehen Ihre Anforderungen und
          Erwartungen. Wir legen großen Wert auf eine zuverlässige Ausführung,
          transparente Abläufe und eine partnerschaftliche Zusammenarbeit.
        </p>
      </div>
      <div class="grid md:grid-cols-2 gap-x-6 gap-y-8">
        {trustItems.map((item) => (
          <TrustCard {...item} />
        ))}
      </div>
    </div>
  </section>
</Layout>
