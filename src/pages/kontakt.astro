---
import Layout from "../layouts/Layout.astro";
import ContactForm from "../components/ContactForm.astro";
import ContactCard from "../components/ContactCard.astro";
import { contact } from "../data/contact";

const pageTitle = "Kontaktieren Sie uns";
---

<Layout pageTitle={pageTitle}>
  <section class="py-12 md:py-24 px-4 max-w-6xl mx-auto">
    <div class="max-w-6xl mx-auto mb-12 md:mb-18">
      <!-- Page Heading -->
      <div class="text-center">
        <h1 class="text-4xl md:text-5xl font-bold mb-4">
          Kontaktieren Sie uns!
        </h1>
        <p class="text-gray-600 text-lg max-w-2xl mx-auto">
          Kontaktieren Sie uns für ein kostenloses Angebot oder Fragen zu
          unseren Dienstleistungen. Wir melden uns so schnell wie möglich bei
          Ihnen.
        </p>
      </div>
    </div>
    <ContactForm />
  </section>

  <section class="max-w-6xl mx-auto px-4 pb-12 md:pb-24 space-y-12">
    <!-- Contact Info -->
    <div class="space-y-8">
      <div>
        <h1 class="text-3xl md:text-4xl font-bold mb-4">
          Kontaktinformationen
        </h1>
        <p class="text-gray-600 text-lg">
          Sie können uns gerne per Telefon oder E-Mail kontaktieren.
        </p>
      </div>

      <div class="grid gap-8 md:grid-cols-2">
        <ContactCard
          type="phone"
          title="Unsere Telefonnummer"
          href={contact.phoneHref}
          value={contact.phone}
        />
        <ContactCard
          type="email"
          title="Unsere E-Mail-Adresse"
          href={contact.emailHref}
          value={contact.email}
        />
      </div>
    </div>
  </section>
</Layout>
